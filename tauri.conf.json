{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPIRAL AI",
  "version": "1.2.0",
  "identifier": "com.spiralai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SPIRAL AI",
        "width": 1280,
        "height": 820,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "SPIRAL AI assistant",
    "longDescription": "A fast AI assistant for conversation, coding, research, files and creative tasks.",
    "windows": {
      "nsis": {
        "installMode": "perUser"
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}